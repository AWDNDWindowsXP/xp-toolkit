{
  "schemaVersion": 1,
  "id": "xptoolkit",
  "version": "${version}",
  "name": "XPToolkit",
  "description": "XP's client-side Minecraft toolkit, built on MaLiLib. Small utility features and configurable hotkeys for 1.21.11.",
  "authors": [
    "XP"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.xp.xptoolkit.XPToolkitClient"
    ],
    "modmenu": [
      "com.xp.xptoolkit.config.ModMenu"
    ]
  },
  "mixins": [
    "xptoolkit.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21",
    "fabric-api": "*",
    "malilib": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
